<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="guper_pos_cashback.AmountPopup">
        <div class="popup guper-amount-popup" role="dialog">
            <header class="title">Canjear cashback</header>
            <main class="body">
                <p>
                    <span class="text-muted">Saldo total del cliente:</span>
                    <strong class="ms-1" t-esc="balanceLabel"/>
                </p>
                <p>
                    <span class="text-muted">Disponible en esta compra:</span>
                    <strong class="ms-1" t-esc="redeemableLabel"/>
                </p>
                <div class="mt-3">
                    <label class="form-label">Monto a canjear</label>
                    <input type="number" step="0.01" min="0"
                           t-att-max="maxAmount"
                           class="form-control form-control-lg"
                           t-model="state.amount"/>
                </div>
                <p t-if="!valid" class="text-danger mt-1">
                    Ingrese un monto entre 0 y <t t-esc="redeemableLabel"/>.
                </p>
            </main>
            <footer class="footer">
                <div class="button confirm highlight" t-on-click="confirm">Aplicar</div>
                <div class="button cancel" t-on-click="cancel">Cancelar</div>
            </footer>
        </div>
    </t>
</templates>
