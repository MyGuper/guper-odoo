<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="guper_pos_cashback.AmountPopup">
        <Dialog title.translate="¿Desea redimir cashback?">
            <div class="guper-amount-popup">
                <p>
                    <span class="text-muted">Saldo total del cliente:</span>
                    <strong class="ms-1" t-esc="balanceLabel"/>
                </p>
                <p>
                    <span class="text-muted">Disponible en esta compra:</span>
                    <strong class="ms-1" t-esc="redeemableLabel"/>
                </p>
                <div class="mt-3">
                    <label class="form-label">Monto a redimir</label>
                    <input type="number" step="0.01" min="0"
                           t-att-max="maxAmount"
                           class="form-control form-control-lg"
                           t-model="state.amount"/>
                </div>
                <p t-if="!valid" class="text-danger mt-1">
                    Ingrese un monto entre 0 y <t t-esc="redeemableLabel"/>.
                </p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-outline-secondary" t-on-click="onCancel">No redimir</button>
                <button class="btn btn-primary" t-on-click="onConfirm"
                        t-att-disabled="!valid">Redimir</button>
            </t>
        </Dialog>
    </t>
</templates>
