<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="guper_pos_cashback.AmountPopup">
        <div class="popup guper-popup" role="dialog">
            <div class="gp-header"><h4>Canjear cashback</h4></div>
            <div class="gp-body">
                <div class="gp-row">
                    <span class="gp-muted">Saldo total del cliente</span>
                    <span class="gp-strong" t-esc="balanceLabel"/>
                </div>
                <div class="gp-row">
                    <span class="gp-muted">Disponible en esta compra</span>
                    <span class="gp-strong" t-esc="redeemableLabel"/>
                </div>
                <div class="mt-3">
                    <label class="form-label">Monto a canjear</label>
                    <input type="number" step="0.01" min="0"
                           t-att-max="maxAmount"
                           class="form-control form-control-lg"
                           t-model="state.amount"/>
                </div>
                <p t-if="!valid" class="text-danger mt-2 mb-0">
                    Ingrese un monto entre 0 y <t t-esc="redeemableLabel"/>.
                </p>
            </div>
            <div class="gp-footer">
                <button class="btn btn-link text-muted me-auto" t-on-click="cancel">Cancelar</button>
                <button class="btn btn-primary" t-on-click="confirm"
                        t-att-disabled="!valid">Aplicar</button>
            </div>
        </div>
    </t>
</templates>
