<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 19: injeta o botao Cashback Guper no modal de acoes ("More")
         do ControlButtons, junto de Refund/Pricelist. -->
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-att-class="buttonClass" t-on-click="() => this.onGuperCashback()">
                <i class="fa fa-gift me-1" role="img" title="Cashback Guper"/>
                Cashback Guper
            </button>
        </xpath>
    </t>
</templates>
