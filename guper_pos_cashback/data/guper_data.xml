<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Produto usado como linha de desconto negativa do resgate.
             Ligue-o em cada pos.config (campo Guper Cashback). -->
        <!-- Parametros globais (edite os valores em Config. Tecnicas > Parametros do Sistema).
             guper.enabled ja nasce False = trava de seguranca (ver staging Odoo.sh). -->
        <record id="guper_param_enabled" model="ir.config_parameter">
            <field name="key">guper.enabled</field>
            <field name="value">False</field>
        </record>
        <record id="guper_param_base_url" model="ir.config_parameter">
            <field name="key">guper.base_url</field>
            <field name="value"></field>
        </record>
        <record id="guper_param_apikey" model="ir.config_parameter">
            <field name="key">guper.apikey</field>
            <field name="value"></field>
        </record>
        <record id="guper_param_apisecret" model="ir.config_parameter">
            <field name="key">guper.apisecret</field>
            <field name="value"></field>
        </record>
        <!-- Campo identificador del cliente: phone | email | document -->
        <record id="guper_param_client_id_field" model="ir.config_parameter">
            <field name="key">guper.client_id_field</field>
            <field name="value">phone</field>
        </record>

        <record id="product_guper_cashback" model="product.product">
            <field name="name">Cashback Guper</field>
            <field name="type">service</field>
            <field name="available_in_pos" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>
    </data>
</odoo>
