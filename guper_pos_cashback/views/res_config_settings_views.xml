<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_guper" model="ir.ui.view">
        <field name="name">res.config.settings.form.guper</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals']" position="after">
                <block title="Guper API" id="guper_api" invisible="not module_point_of_sale">
                    <setting string="Guper ativo" help="Ligue apenas na producao. Em staging deixe desligado.">
                        <field name="guper_enabled"/>
                    </setting>
                    <setting string="Base URL" help="https://{org}.myguper.com">
                        <field name="guper_base_url"/>
                    </setting>
                    <setting string="API Key">
                        <field name="guper_apikey"/>
                    </setting>
                    <setting string="API Secret" help="Nunca exposto ao front do POS">
                        <field name="guper_apisecret" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
